# BloomIndex — sanitized environment template (no secrets).
# Copy to .env and fill in values:  cp .env.example .env

# --- Unified LLM (OpenAI Python SDK, Chat Completions) ---
# Single connection for RAG, NER, and RAGAS evaluation. The target
# changes only through these three variables.
#   Official OpenAI:    LLM_API_BASE_URL=https://api.openai.com/v1
#   OpenRouter:         LLM_API_BASE_URL=https://openrouter.ai/api/v1
#   Self-hosted/vLLM:   LLM_API_BASE_URL=http://localhost:8000/v1
#   Ollama (compat):    LLM_API_BASE_URL=http://localhost:11434/v1
# Must be a /v1 root — never /v1/chat/completions or /api/chat.
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
# Transport policy for the shared SDK client.
LLM_TIMEOUT_SECONDS=300.0
LLM_MAX_RETRIES=2
# Thinking control: false (default) appends LLM_NO_THINK_DIRECTIVE to the
# last user message — honored by Qwen-style chat templates, inert elsewhere.
# Set LLM_THINKING=true to allow chain-of-thought, or empty the directive
# to append nothing. No server guarantee: reasoning-native models only obey
# server-side flags (e.g. llama.cpp reasoning controls, OpenRouter
# reasoning.enabled=false), not prompt text.
LLM_THINKING=false
LLM_NO_THINK_DIRECTIVE=/no_think
# Pre-unification compat behavior: forward enable_thinking via
# chat_template_kwargs (what the old OpenRouter/llama.cpp path sent).
# Default off — official OpenAI rejects unknown fields, and it breaks
# some OpenRouter routes outright (Nemotron 2026-09: choiceless body).
# Enable only for llama.cpp/vLLM targets that honor it.
# LLM_CHAT_TEMPLATE_KWARGS=true
# Context window of the shared target model. Drives the RAG retrieval
# budget (window minus reserve); the server's own ceiling still applies.
LLM_CONTEXT_WINDOW=8192

# --- Qdrant: server when URL set, embedded otherwise ---
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_DIR=

# --- Embeddings (single model; a load failure raises, no silent swap) ---
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RAG_EMBEDDING_DIM=
# RAG_EMBEDDING_INSTRUCTION=
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_FLASH_ATTENTION=false
RAG_MULTI_GPU=false
# Rerank throughput (sub-batch per forward pass; scores identical at any
# value — raise for speed, lower only on OOM). Candidate pool size.
# RAG_RERANK_BATCH_SIZE=8
# RAG_RERANK_CANDIDATE_K=40
# Force embedder/reranker device (auto-detect when empty: cuda | mps | cpu).
# RAG_DEVICE=

# --- RAG tuning ---
RAG_TEMPERATURE=0.1
RAG_TOP_K=10
RAG_SIMILARITY_THRESHOLD=0.85
RAG_QUERY_TIMEOUT_SECONDS=180
# Citation attribution: fast (default) or llm_select (extra LLM call).
# RAG_CITATION_MODE=fast

# --- NER: chunking, validation retries, LLM time budget ---
# NER_HYBRID=false disables the LLM phase (dictionary-only, zero cost).
NER_HYBRID=true
NER_CONFIDENCE_THRESHOLD=0.7
NER_CHUNK_WORDS=250
NER_MAX_CHUNKS=3
NER_UPLOAD_CHUNK_WORDS=600
NER_MAX_ATTEMPTS=2
NER_BUDGET_SECONDS=240.0
# Parallel LLM sections (1 = sequential, kindest to local GPUs).
# NER_CONCURRENCY=1
